<%= form_with(model: tweet, class: "form-grid") do |form| %>
  <% if tweet.errors.any? %>
    <div class="flash flash--alert">
      <span class="err"><%= tweet.errors.full_messages.to_sentence %></span>
    </div>
  <% end %>

  <div class="form-row">
    <%= form.label :author, "Your name:" %>
    <%= form.text_field :author %>
  </div>

  <div class="form-row">
    <%= form.label :content, "Your tweet:" %>
    <%= form.text_area :content, rows: 2 %>
  </div>

  <div class="actions">
    <%= form.submit "Tweet" %>
  </div>
<% end %>